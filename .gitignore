# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage
/.nyc_output

# next.js build and cache output
/.next/
/out/
/build/
/dist/

# production & environment variables
.env
.env*.local
.env.development.local
.env.test.local
.env.production.local
*.env

# debug & logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*

# vercel & deployment configurations
.vercel
.open-next

# TypeScript & configuration cache
*.tsbuildinfo
next-env.d.ts

# Editor directories and files
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*~

# OS & System generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Diagnostic & Crash reports
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json
core
